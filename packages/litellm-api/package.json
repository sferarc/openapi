{
	"name": "litellm-api",
	"version": "2.4.0",
	"description": "LiteLLM auto-generated type-safe API client",
	"type": "module",
	"author": "SferaDev",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sferarc/openapi.git",
		"directory": "packages/litellm-api"
	},
	"bugs": {
		"url": "https://github.com/sferarc/openapi/issues"
	},
	"homepage": "https://github.com/sferarc/openapi/tree/main/packages/litellm-api#readme",
	"scripts": {
		"tsc": "tsc --noEmit",
		"build": "bunchee",
		"generate": "rimraf ./src/generated && kubb generate",
		"is-tree-shakable": "is-tree-shakable",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"kubb": "catalog:",
		"@sferadev/openapi-utils": "workspace:*",
		"@sferadev/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"bunchee": "catalog:",
		"openapi3-ts": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"files": [
		"dist"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./types": {
			"import": {
				"types": "./dist/types.d.mts",
				"default": "./dist/types.mjs"
			},
			"require": {
				"types": "./dist/types.d.cts",
				"default": "./dist/types.cjs"
			}
		},
		"./schemas": {
			"import": {
				"types": "./dist/schemas.d.mts",
				"default": "./dist/schemas.mjs"
			},
			"require": {
				"types": "./dist/schemas.d.cts",
				"default": "./dist/schemas.cjs"
			}
		},
		"./components": {
			"import": {
				"types": "./dist/components.d.mts",
				"default": "./dist/components.mjs"
			},
			"require": {
				"types": "./dist/components.d.cts",
				"default": "./dist/components.cjs"
			}
		}
	},
	"typesVersions": {
		"*": {
			"types": [
				"./dist/types.d.cts"
			],
			"schemas": [
				"./dist/schemas.d.cts"
			],
			"components": [
				"./dist/components.d.cts"
			]
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
