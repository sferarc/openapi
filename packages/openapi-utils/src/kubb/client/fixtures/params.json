{
	"openapi": "3.0.3",
	"info": { "title": "Params fixture", "version": "1.0.0" },
	"servers": [{ "url": "https://api.test" }],
	"paths": {
		"/teams/{team-id}/members/{member_id}": {
			"get": {
				"operationId": "getMember",
				"tags": ["members"],
				"parameters": [
					{ "name": "team-id", "in": "path", "required": true, "schema": { "type": "string" } },
					{ "name": "member_id", "in": "path", "required": true, "schema": { "type": "integer" } },
					{ "name": "fields", "in": "query", "required": true, "schema": { "type": "string" } },
					{ "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
					{ "name": "cursor", "in": "query", "schema": { "$ref": "#/components/schemas/Cursor" } },
					{
						"name": "status",
						"in": "query",
						"schema": {
							"oneOf": [{ "type": "string", "enum": ["active", "invited"] }, { "type": "integer" }]
						}
					},
					{
						"name": "X-Trace-Id",
						"in": "header",
						"required": false,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "object", "properties": { "id": { "type": "integer" } } }
							}
						}
					}
				}
			}
		},
		"/zones": {
			"get": {
				"operationId": "listZones",
				"tags": ["zones"],
				"parameters": [
					{
						"name": "type",
						"in": "query",
						"explode": false,
						"schema": { "type": "array", "items": { "type": "string" } }
					},
					{
						"name": "filter.ids",
						"in": "query",
						"style": "pipeDelimited",
						"schema": { "type": "array", "items": { "type": "integer" } }
					},
					{
						"name": "tag",
						"in": "query",
						"schema": { "type": "array", "items": { "type": "string" } }
					},
					{ "name": "name", "in": "query", "explode": false, "schema": { "type": "string" } }
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": { "application/json": { "schema": { "type": "object" } } }
					}
				}
			}
		},
		"/scripts/{name}": {
			"put": {
				"operationId": "uploadScript",
				"tags": ["scripts"],
				"parameters": [
					{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
				],
				"requestBody": {
					"required": true,
					"content": {
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"required": ["metadata"],
								"properties": {
									"files": { "type": "array", "items": { "type": "string", "format": "binary" } },
									"metadata": {
										"type": "object",
										"properties": { "main_module": { "type": "string" } }
									},
									"tags": { "type": "array", "items": { "type": "string" } },
									"size": { "type": "integer" },
									"draft": { "type": "boolean" },
									"note": { "type": "string", "nullable": true }
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } }
							}
						}
					}
				}
			}
		},
		"/orgs/{org}/invite": {
			"post": {
				"operationId": "inviteMember",
				"tags": ["members"],
				"parameters": [
					{ "name": "org", "in": "path", "required": true, "schema": { "type": "string" } }
				],
				"requestBody": {
					"content": {
						"application/x-www-form-urlencoded": {
							"schema": {
								"type": "object",
								"required": ["email"],
								"properties": {
									"email": { "type": "string" },
									"roles": { "type": "array", "items": { "type": "string" } },
									"profile": {
										"type": "object",
										"properties": { "firstName": { "type": "string" } }
									},
									"notify": { "type": "boolean" },
									"note": { "type": "string", "nullable": true }
								}
							}
						}
					}
				},
				"responses": {
					"204": { "description": "Invited" }
				}
			}
		},
		"/orgs/{org}/logos": {
			"post": {
				"operationId": "uploadLogo",
				"tags": ["members"],
				"parameters": [
					{ "name": "org", "in": "path", "required": true, "schema": { "type": "string" } }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/x-www-form-urlencoded": {
							"schema": { "$ref": "#/components/schemas/LogoFile" }
						}
					}
				},
				"responses": {
					"204": { "description": "Uploaded" }
				}
			}
		},
		"/orgs/{org}/scim/Users": {
			"post": {
				"operationId": "createScimUser",
				"tags": ["members"],
				"parameters": [
					{ "name": "org", "in": "path", "required": true, "schema": { "type": "string" } }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/scim+json": {
							"schema": {
								"type": "object",
								"required": ["userName"],
								"properties": {
									"userName": { "type": "string" },
									"active": { "type": "boolean" }
								}
							}
						}
					}
				},
				"responses": {
					"201": { "description": "Created" }
				}
			}
		},
		"/health": {
			"get": {
				"operationId": "getHealth",
				"tags": ["health"],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } }
							}
						}
					}
				}
			}
		},
		"/commands": {
			"post": {
				"operationId": "runCommand",
				"tags": ["commands"],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["command"],
								"properties": { "command": { "type": "string" }, "wait": { "type": "boolean" } }
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "The command, or one status line per change with wait",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["command"],
									"properties": { "command": { "$ref": "#/components/schemas/Command" } }
								}
							},
							"application/x-ndjson": {
								"schema": {
									"type": "object",
									"required": ["command", "stream"],
									"properties": {
										"command": { "$ref": "#/components/schemas/Command" },
										"stream": { "type": "string" }
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Command": {
				"type": "object",
				"required": ["id"],
				"properties": {
					"id": { "type": "string" },
					"exitCode": { "type": "integer", "nullable": true }
				}
			},
			"Cursor": { "type": "string", "nullable": true },
			"LogoFile": {
				"type": "object",
				"properties": {
					"image": { "type": "string", "format": "binary" },
					"tag": { "type": "string" }
				}
			}
		}
	}
}
