{
	"name": "keycloak-api",
	"version": "3.7.0",
	"description": "Unofficial typed TypeScript client for the Keycloak Admin and Account REST APIs, generated from their OpenAPI specs",
	"keywords": [
		"keycloak",
		"keycloak-api",
		"api-client",
		"sdk",
		"typescript",
		"openapi",
		"rest",
		"effect"
	],
	"type": "module",
	"author": "SferaDev",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sferarc/openapi.git",
		"directory": "packages/keycloak-api"
	},
	"bugs": {
		"url": "https://github.com/sferarc/openapi/issues"
	},
	"homepage": "https://openapi.sferadev.com/keycloak-api",
	"mcpName": "io.github.sferarc/keycloak-api-mcp",
	"scripts": {
		"tsc": "tsc --noEmit",
		"build": "bunchee --dts-bundle",
		"generate": "rimraf ./src/admin/generated ./src/account/generated && kubb generate && KUBB_TARGET=account kubb generate",
		"is-tree-shakable": "is-tree-shakable",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"@sferadev/openapi-utils": "workspace:*",
		"@sferadev/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"bunchee": "catalog:",
		"effect": "catalog:",
		"kubb": "catalog:",
		"openapi3-ts": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"yaml": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		}
	},
	"files": [
		"dist",
		"src/admin/generated/OPERATIONS.md",
		"src/account/generated/OPERATIONS.md"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"bin": {
		"keycloak-api-mcp": "./dist/bin/keycloak-api-mcp.js"
	},
	"sideEffects": false,
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./admin/types": {
			"import": {
				"types": "./dist/admin/types.d.mts",
				"default": "./dist/admin/types.mjs"
			},
			"require": {
				"types": "./dist/admin/types.d.cts",
				"default": "./dist/admin/types.cjs"
			}
		},
		"./admin/schemas": {
			"import": {
				"types": "./dist/admin/schemas.d.mts",
				"default": "./dist/admin/schemas.mjs"
			},
			"require": {
				"types": "./dist/admin/schemas.d.cts",
				"default": "./dist/admin/schemas.cjs"
			}
		},
		"./admin/components": {
			"import": {
				"types": "./dist/admin/components.d.mts",
				"default": "./dist/admin/components.mjs"
			},
			"require": {
				"types": "./dist/admin/components.d.cts",
				"default": "./dist/admin/components.cjs"
			}
		},
		"./account/types": {
			"import": {
				"types": "./dist/account/types.d.mts",
				"default": "./dist/account/types.mjs"
			},
			"require": {
				"types": "./dist/account/types.d.cts",
				"default": "./dist/account/types.cjs"
			}
		},
		"./account/schemas": {
			"import": {
				"types": "./dist/account/schemas.d.mts",
				"default": "./dist/account/schemas.mjs"
			},
			"require": {
				"types": "./dist/account/schemas.d.cts",
				"default": "./dist/account/schemas.cjs"
			}
		},
		"./account/components": {
			"import": {
				"types": "./dist/account/components.d.mts",
				"default": "./dist/account/components.mjs"
			},
			"require": {
				"types": "./dist/account/components.d.cts",
				"default": "./dist/account/components.cjs"
			}
		},
		"./effect": {
			"import": {
				"types": "./dist/effect.d.mts",
				"default": "./dist/effect.mjs"
			},
			"require": {
				"types": "./dist/effect.d.cts",
				"default": "./dist/effect.cjs"
			}
		}
	},
	"typesVersions": {
		"*": {
			"admin/types": [
				"./dist/admin/types.d.cts"
			],
			"admin/schemas": [
				"./dist/admin/schemas.d.cts"
			],
			"admin/components": [
				"./dist/admin/components.d.cts"
			],
			"account/types": [
				"./dist/account/types.d.cts"
			],
			"account/schemas": [
				"./dist/account/schemas.d.cts"
			],
			"account/components": [
				"./dist/account/components.d.cts"
			],
			"effect": [
				"./dist/effect.d.cts"
			]
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
