{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["turbo.json", ".github/workflows/scripts/*.ts"],
			"ignoreDependencies": ["@typescript/typescript6"]
		},
		"apps/openapi": {
			"entry": ["src/app/**/*.{ts,tsx}", "src/lib/**/*.ts", "src/components/**/*.tsx"],
			"project": ["src/**/*.{ts,tsx,css}"]
		},
		"packages/openapi-utils": {
			"entry": ["src/index.ts", "src/effect/index.ts"],
			"project": ["src/**/*.{ts,tsx}"],
			"ignoreDependencies": ["@types/react", "@types/react-dom", "react", "react-dom"]
		},
		"packages/vercel-api-js": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"src/effect.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/v0-api": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"src/effect.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/cloudflare-api-js": {
			"entry": ["src/index.ts", "src/types.ts", "src/components.ts", "kubb.config.ts"],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/netlify-api": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"src/effect.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/zoom-api-js": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"src/effect.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/keycloak-api": {
			"entry": [
				"src/index.ts",
				"src/admin/types.ts",
				"src/admin/schemas.ts",
				"src/admin/components.ts",
				"src/account/types.ts",
				"src/account/schemas.ts",
				"src/account/components.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/nuki-api-js": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"src/effect.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/litellm-api": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"packages/clickhouse-cloud": {
			"entry": [
				"src/index.ts",
				"src/types.ts",
				"src/schemas.ts",
				"src/components.ts",
				"src/effect.ts",
				"kubb.config.ts"
			],
			"project": ["src/**/*.ts"],
			"includeEntryExports": false
		},
		"configs/tsconfig": {}
	},
	"ignoreWorkspaces": ["configs/tsconfig"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"duplicates": "off",
		"optionalPeerDependencies": "off"
	}
}
