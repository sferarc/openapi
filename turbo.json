{
	"$schema": "https://turborepo.com/schema.json",
	"globalPassThroughEnv": [
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"DATABASE_URL",
		"AUTH_VERCEL_ID",
		"AUTH_VERCEL_SECRET",
		"AUTH_VERCEL_APP_NAME"
	],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
			"dependsOn": ["^build"]
		},
		"@sferadev/openapi-website#build": {
			"env": [
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"DATABASE_URL",
				"AUTH_VERCEL_ID",
				"AUTH_VERCEL_SECRET",
				"AUTH_VERCEL_APP_NAME"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"generate": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"tsc": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"is-tree-shakable": {
			"dependsOn": ["build"]
		},
		"clean": {
			"cache": false
		}
	}
}
