{
	"name": "openapi",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"generate": "turbo run generate",
		"check": "biome check . && knip --config configs/knip.json && turbo run is-tree-shakable --filter='./packages/*'",
		"check:fix": "biome check . --write",
		"tsc": "turbo run tsc && tsc -p .github/workflows/scripts",
		"test": "turbo run test && vitest run --dir .github/workflows/scripts",
		"knip": "knip --config configs/knip.json",
		"clean": "turbo run clean && rm -rf node_modules",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "./scripts/release.sh",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@ai-sdk/openai": "catalog:",
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"@types/node": "catalog:",
		"ai": "catalog:",
		"is-tree-shakable": "catalog:",
		"knip": "catalog:",
		"lefthook": "catalog:",
		"tsx": "catalog:",
		"turbo": "catalog:",
		"@typescript/typescript6": "catalog:",
		"typescript": "catalog:",
		"zod": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22"
	}
}
